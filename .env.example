# Copie para .env (que NÃO vai para o Git) e troque todos os valores.
DB_USER=meioameio
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-tambem

# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres
# 32 bytes em Base64. Gere com: openssl rand -base64 32
APP_CRIPTO_CHAVE=troque-por-32-bytes-em-base64
ADMIN_SENHA=troque-a-senha-do-painel
